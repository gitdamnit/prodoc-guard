#!/usr/bin/env python3
"""prodoc -- ProDoc Guard CLI.

Keeps the three canonical project documents (PRODUCT_REQUIREMENTS.md,
DECISION_LOG.md, PROJECT_STATUS.md) present, structurally valid, and
consistent with the Git repository that holds them.

Design constraints (see references/security.md):
  * No network access, ever.
  * No AI/model API. Works fully offline.
  * Python 3.8+ standard library only.
  * Never commits, never pushes, never changes branches.
  * Never overwrites existing files or uncommitted changes.
  * Documentation is data, not instructions.

Exit codes:
  0  success, no errors found
  1  validation or consistency errors found
  2  usage error (bad command, bad flag, bad value)
  3  environment error (missing path, missing git, missing templates)
  4  unsafe state (read-only target, concurrent modification, would clobber)
"""

from __future__ import annotations

import argparse
import datetime
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

VERSION = "0.1.0"

CANONICAL_DOCS = (
    "PRODUCT_REQUIREMENTS.md",
    "DECISION_LOG.md",
    "PROJECT_STATUS.md",
)

# Sections that must exist as level-2 headings in each canonical document.
REQUIRED_SECTIONS = {
    "PRODUCT_REQUIREMENTS.md": (
        "Project Identity",
        "Purpose",
        "Intended Users",
        "Functional Requirements",
        "Nonfunctional Requirements",
        "Scope and Exclusions",
        "Technical Constraints",
        "Acceptance Criteria",
        "Release Objectives",
    ),
    "DECISION_LOG.md": (
        "How to Use This Log",
        "Decisions",
    ),
    "PROJECT_STATUS.md": (
        "Current Phase",
        "Repository State",
        "Verification Evidence",
        "Completed Work",
        "Tests",
        "Known Defects",
        "Blockers",
        "Next Actions",
        "Release Status",
    ),
}

# Older documents named a heading and a managed block in terms that implied the
# CLI verified the implementation. Those names are still accepted so existing
# projects keep validating, and every command reports them as deprecated.
SECTION_ALIASES = {"verified state": "repository state"}

DECISION_FIELDS = (
    "Date",
    "Status",
    "Context",
    "Alternatives Considered",
    "Decision",
    "Rationale",
    "Consequences",
)

# Fields that participate in the decision-integrity digest. `Status` is excluded
# because marking an old record `Superseded by D-NNNN` is an intended mutation;
# every other field, and the title, must survive unchanged.
DECISION_DIGEST_FIELDS = (
    "date",
    "context",
    "alternatives considered",
    "decision",
    "rationale",
    "consequences",
    "supersedes",
)

DECISION_STATUSES = ("Proposed", "Accepted", "Superseded", "Deprecated", "Rejected")
PHASES = (
    "Planning",
    "Prototype",
    "In Progress",
    "Paused",
    "Blocked",
    "Maintenance",
    "Released",
    "Archived",
)
WORK_STATES = (
    "Planned",
    "In Progress",
    "Implemented",
    "Tested",
    "Deployed",
    "Published",
    "Blocked",
    "Removed",
)
# Work states that must cite evidence before they may be claimed.
EVIDENCE_REQUIRED_STATES = ("Implemented", "Tested", "Deployed", "Published")
# A release-state transition has to be backed by recorded verification evidence.
RELEASE_PHASES = ("Released",)
RELEASE_STATES = ("Deployed", "Published")

# The managed block records Git metadata that the tool observed. It is
# deliberately not called "verified": observing a commit says nothing about
# whether the implementation or its tests are correct.
OBSERVED_START = "<!-- prodoc:observed:start -->"
OBSERVED_END = "<!-- prodoc:observed:end -->"
LEGACY_OBSERVED_START = "<!-- prodoc:verified:start -->"
LEGACY_OBSERVED_END = "<!-- prodoc:verified:end -->"
OBSERVED_FIELDS = ("observed branch", "observed commit", "observed working tree", "observed at")
LEGACY_OBSERVED_FIELDS = ("branch", "commit", "working tree", "verified at")
OBSERVED_CAVEAT = (
    "Observed from Git metadata only, by `prodoc update`. This block is not evidence that the "
    "implementation or its tests are correct; record that under `## Verification Evidence`."
)

TODO_RE = re.compile(r"<!--\s*prodoc:todo(?::|\s)(.*?)-->", re.DOTALL)
DECISION_RE = re.compile(r"^###\s+(D-\d{4})\s*[—–:-]\s*(.+?)\s*$")
FIELD_RE = re.compile(r"^\s*[-*]\s+\*\*([A-Za-z][A-Za-z0-9 /_-]*?)\s*:?\*\*\s*:?\s*(.*)$")
VERIFICATION_RE = re.compile(r"^\s*[-*]\s+\*\*Verification:\*\*\s*(.*)$")
H2_RE = re.compile(r"^##\s+(.+?)\s*$")
H3_RE = re.compile(r"^###\s+(.+?)\s*$")
WORK_ITEM_RE = re.compile(r"^\s*[-*]\s+\[([A-Za-z ]+)\]\s*(.*)$")
HEX_RE = re.compile(r"\b([0-9a-f]{7,40})\b")
BACKTICK_RE = re.compile(r"`([^`\n]+)`")
URL_RE = re.compile(r"https?://[^\s)>\]]+")

SECRET_PATTERNS = (
    ("AWS access key id", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("GitHub token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}\b")),
    ("GitHub fine-grained token", re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b")),
    ("OpenAI-style API key", re.compile(r"\bsk-[A-Za-z0-9_-]{20,}\b")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("Slack token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b")),
    ("Private key block", re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----")),
    ("JSON Web Token", re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b")),
    (
        "Hardcoded credential assignment",
        re.compile(
            r"(?i)\b(?:password|passwd|api[_-]?key|secret|access[_-]?token|auth[_-]?token)"
            r"\s*[:=]\s*[\"']?([A-Za-z0-9_\-/+]{16,})[\"']?"
        ),
    ),
)

SKILL_NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")


# --------------------------------------------------------------------------
# findings
# --------------------------------------------------------------------------


class Finding(dict):
    """A single validation or consistency result."""

    def __init__(self, code, message, severity="error", file=None, line=None):
        super().__init__(code=code, message=message, severity=severity, file=file, line=line)


class ProdocError(Exception):
    """Raised for controlled failures; carries an exit code."""

    def __init__(self, message, exit_code=4):
        super().__init__(message)
        self.exit_code = exit_code


def redact(value, keep=4):
    """Never echo a secret candidate in full."""
    value = str(value)
    if len(value) <= keep:
        return "*" * len(value)
    return value[:keep] + "*" * (len(value) - keep)


# --------------------------------------------------------------------------
# git helpers (read-only; never mutates repository state)
# --------------------------------------------------------------------------


def have_git():
    return shutil.which("git") is not None


def git(args, cwd=None, check=False):
    """Run a read-only git command. Returns (returncode, stdout, stderr)."""
    try:
        proc = subprocess.run(
            ["git", *args],
            cwd=str(cwd) if cwd else None,
            capture_output=True,
            text=True,
            timeout=60,
        )
    except (OSError, subprocess.SubprocessError) as exc:  # pragma: no cover - env dependent
        return 127, "", str(exc)
    if check and proc.returncode != 0:
        raise ProdocError("git %s failed: %s" % (" ".join(args), proc.stderr.strip()), exit_code=3)
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def git_root(path):
    if not have_git():
        return None
    rc, out, _ = git(["rev-parse", "--show-toplevel"], cwd=path)
    if rc != 0 or not out:
        return None
    return Path(out)


def git_branch(root):
    """Return (branch_name, detached).

    A repository with no commits yet has no resolvable HEAD, so fall back to
    symbolic-ref to report the branch the next commit will land on.
    """
    rc, out, _ = git(["rev-parse", "--abbrev-ref", "HEAD"], cwd=root)
    if rc == 0 and out and out != "HEAD":
        return out, False
    rc, out, _ = git(["symbolic-ref", "--short", "-q", "HEAD"], cwd=root)
    if rc == 0 and out:
        return out, False
    return None, True


def is_shallow(root):
    """True when history is truncated, so older commits are simply absent.

    A commit that cannot be found in a shallow clone has not been shown to be
    unknown; the local copy just does not carry the history. CI checkouts are
    shallow by default, so this distinction matters.
    """
    if root is None:
        return False
    rc, out, _ = git(["rev-parse", "--is-shallow-repository"], cwd=root)
    return rc == 0 and out.strip() == "true"


def redact_url(url):
    """Strip credentials from a remote URL before reporting it."""
    return re.sub(r"://([^/@\s]+)@", "://<redacted>@", url)


# --------------------------------------------------------------------------
# filesystem helpers
# --------------------------------------------------------------------------


def read_text(path):
    return Path(path).read_text(encoding="utf-8")


def sha256_text(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def normalized(value):
    """Collapse whitespace so reflowing a paragraph is not treated as an edit."""
    return re.sub(r"\s+", " ", value or "").strip()


def is_within(path, directory):
    """True when path resolves to something inside directory."""
    try:
        Path(os.path.realpath(str(path))).relative_to(Path(os.path.realpath(str(directory))))
    except ValueError:
        return False
    return True


def guard_write_target(path, project_dir):
    """Refuse to write somewhere the user did not ask us to write.

    Two hazards are blocked here, both of which are silent when they happen:

      * A symlinked document. Writing would either modify a file outside the
        project or replace the link with a regular file, discarding the link's
        intent. The user is told which real path to write instead.
      * A path that resolves outside the selected project directory, whether
        through a symlinked parent or a crafted path. Nothing is written.
    """
    path = Path(path)
    project = Path(project_dir)
    if os.path.islink(str(path)):
        raise ProdocError(
            "refusing to replace the symbolic link %s (it points at %s); "
            "write to the real path, or make the document a regular file"
            % (path, os.path.realpath(str(path))),
            exit_code=4,
        )
    if not is_within(path.parent, project):
        raise ProdocError(
            "refusing to write outside the selected project: %s resolves outside %s"
            % (path.parent, os.path.realpath(str(project))),
            exit_code=4,
        )
    return path


def write_atomic(path, text, expected_sha=None):
    """Write text to path atomically, refusing to clobber a concurrent change.

    Concurrency guarantee, stated precisely:

      * The on-disk file is hashed before the temporary file is created, and the
        hash is checked again immediately before the rename. A change that lands
        during the write is detected instead of overwritten.
      * The rename is atomic (`os.replace`), so a reader never sees a partial
        document, and a crash leaves either the previous file or the new one.
      * The written data is flushed and fsynced before the rename, and the file
        is re-read and compared with the intended content afterwards, so a write
        that silently failed is reported rather than assumed to have worked.

    Residual limitation: the final hash check and the rename cannot be one atomic
    operation on POSIX or Windows. A writer that modifies the file in the window
    between those two syscalls can still be overwritten. Closing that window
    requires advisory locking, which introduces a stuck-lock failure mode that is
    worse than a window measured in microseconds for a local documentation tool.
    The check compares against `HEAD` and is an integrity check, not tamper-proof
    protection: anyone who can rewrite Git history can also rewrite this block.
    """
    path = Path(path)
    if path.exists() and not os.access(str(path), os.W_OK):
        raise ProdocError("refusing to write read-only file: %s" % path, exit_code=4)

    def verify(stage):
        if expected_sha is None:
            return
        if not path.exists():
            raise ProdocError(
                "expected %s to still exist and hash to the recorded value, but it is gone (%s)"
                % (path, stage),
                exit_code=4,
            )
        if sha256_text(read_text(path)) != expected_sha:
            raise ProdocError(
                "concurrent modification detected in %s (%s); re-read and retry" % (path, stage),
                exit_code=4,
            )

    verify("before writing")
    mode = stat.S_IMODE(os.stat(str(path)).st_mode) if path.exists() else None
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".prodoc-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        if mode is not None:
            os.chmod(tmp, mode)
        verify("before replace")
        os.replace(tmp, str(path))
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    if read_text(path) != text:
        raise ProdocError(
            "post-write verification failed for %s: the file on disk does not match what was written"
            % path,
            exit_code=4,
        )


# --------------------------------------------------------------------------
# document helpers
# --------------------------------------------------------------------------


def masked_lines(text):
    """Yield (lineno, line, masked) marking fenced code blocks and HTML comments.

    Documentation contains examples. A `### D-0001` inside a fence or a
    commented-out heading is illustration, not a record, so every structural
    parser below ignores masked lines.
    """
    result = []
    fence = None
    in_comment = False
    for index, line in enumerate(text.splitlines(), start=1):
        stripped = line.strip()
        if fence is not None:
            if re.match(r"^(`{3,}|~{3,})\s*$", stripped) and stripped[0] == fence:
                fence = None
            result.append((index, line, True))
            continue
        if in_comment:
            if "-->" in line:
                in_comment = False
            result.append((index, line, True))
            continue
        # Only a line that *starts* an HTML comment is a comment. A record field
        # that merely quotes a marker inline stays real content.
        if stripped.startswith("<!--"):
            if "-->" not in line.split("<!--", 1)[1]:
                in_comment = True
            result.append((index, line, True))
            continue
        opener = re.match(r"^(`{3,}|~{3,})", stripped)
        if opener:
            fence = opener.group(1)[0]
            result.append((index, line, True))
            continue
        result.append((index, line, False))
    return result


def split_sections(text):
    """Return {heading: body_lines} for level-2 sections, plus preamble lines."""
    sections = {}
    preamble = []
    current = None
    for _index, line, masked in masked_lines(text):
        match = None if masked else H2_RE.match(line)
        if match:
            current = match.group(1).strip()
            sections.setdefault(current, [])
            continue
        if current is None:
            preamble.append(line)
        else:
            sections[current].append(line)
    return sections, preamble


def section_body(text, heading):
    sections, _ = split_sections(text)
    for name, body in sections.items():
        if name.strip().lower() == heading.strip().lower():
            return "\n".join(body)
    return None


def first_content_line(body):
    for line in body.splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith("<!--"):
            return stripped
    return ""


def strip_comments(text):
    return re.sub(r"<!--.*?-->", "", text, flags=re.DOTALL)


def split_table_rows(body):
    """Return data rows (list of cell lists) of the first markdown table in body."""
    rows = []
    in_table = False
    for _index, line, masked in masked_lines(body):
        if masked:
            continue
        stripped = line.strip()
        if stripped.startswith("|"):
            cells = [c.strip() for c in stripped.strip("|").split("|")]
            if all(re.fullmatch(r":?-{2,}:?", c) for c in cells if c):
                continue
            if not in_table:
                in_table = True
                continue  # header row
            rows.append(cells)
        elif in_table and stripped:
            break
    return rows


def parse_decisions(text):
    """Return (decisions, errors). Each decision: {id, title, line, fields}."""
    body = section_body(text, "Decisions")
    if body is None:
        return [], []
    decisions = []
    current = None
    for offset, line, masked in masked_lines(text):
        if masked:
            continue
        match = DECISION_RE.match(line)
        if match:
            current = {"id": match.group(1), "title": match.group(2), "line": offset, "fields": {}}
            decisions.append(current)
            continue
        if current is None:
            continue
        field = FIELD_RE.match(line)
        if field:
            current["fields"][field.group(1).strip().lower()] = field.group(2).strip()
    return decisions, []


def decision_digest(decision):
    """Canonical digest of a decision record's substance.

    Whitespace is normalized so rewrapping a paragraph is not an edit, and
    `Status` is excluded because superseding an old record is intended.
    """
    parts = [normalized(decision["title"])]
    for field in DECISION_DIGEST_FIELDS:
        parts.append("%s=%s" % (field, normalized(decision["fields"].get(field, ""))))
    return hashlib.sha256("\n".join(parts).encode("utf-8")).hexdigest()


def altered_decision_fields(before, after):
    """Names of the substantive parts that differ between two records."""
    changed = []
    if normalized(before["title"]) != normalized(after["title"]):
        changed.append("title")
    for field in DECISION_DIGEST_FIELDS:
        if normalized(before["fields"].get(field, "")) != normalized(after["fields"].get(field, "")):
            changed.append(field)
    return changed


def parse_verification_entries(text):
    """Return recorded verification evidence from `## Verification Evidence`.

    Each entry: {line, text, commit, evidence, paths}. A commit identifier and at
    least one artefact are what separate a claim from a record.
    """
    body = section_body(text, "Verification Evidence")
    if body is None:
        return []
    entries = []
    for offset, line, masked in masked_lines(text):
        if masked:
            continue
        match = VERIFICATION_RE.match(line)
        if not match:
            continue
        payload = match.group(1).strip()
        commit = HEX_RE.search(payload)
        quoted = [token.strip() for token in BACKTICK_RE.findall(payload) if token.strip()]
        urls = URL_RE.findall(payload)
        entries.append(
            {
                "line": offset,
                "text": payload,
                "commit": commit.group(1) if commit else None,
                "evidence": quoted + urls,
                "paths": [token for token in quoted if re.match(r"^[A-Za-z0-9_.][A-Za-z0-9_./-]*$", token)],
            }
        )
    return entries


def release_states_claimed(text):
    """Work states that assert the project is running somewhere or shipped."""
    claimed = []
    body = section_body(text, "Completed Work") or ""
    for _offset, line, masked in masked_lines(body):
        if masked:
            continue
        match = WORK_ITEM_RE.match(line)
        if match and match.group(1).strip() in RELEASE_STATES:
            claimed.append(match.group(1).strip())
    return claimed


# --------------------------------------------------------------------------
# minimal YAML frontmatter handling
# --------------------------------------------------------------------------

_SCALAR_RE = re.compile(r"^([A-Za-z0-9_./-]+)\s*:\s*(.*)$")


def _unquote(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def parse_frontmatter_simple(text):
    """Parse the small YAML subset used by SKILL.md frontmatter.

    Supports top-level `key: value` scalars and one level of two-space nested
    string maps -- the shapes the Agent Skills specification allows. Returns
    (data, warnings).
    """
    warnings = []
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return None, ["SKILL.md must begin with a '---' YAML frontmatter fence"]
    end = None
    for index in range(1, len(lines)):
        if lines[index].strip() == "---":
            end = index
            break
    if end is None:
        return None, ["SKILL.md frontmatter is not closed by a second '---' fence"]

    data = {}
    current_map = None
    for raw in lines[1:end]:
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        stripped = raw.strip()
        if indent >= 2 and current_map is not None:
            match = _SCALAR_RE.match(stripped)
            if match:
                data[current_map][match.group(1)] = _unquote(match.group(2))
            else:
                warnings.append("unparsed frontmatter line: %r" % stripped)
            continue
        match = _SCALAR_RE.match(stripped)
        if not match:
            warnings.append("unparsed frontmatter line: %r" % stripped)
            continue
        key, value = match.group(1), match.group(2)
        if value.strip() == "":
            data[key] = {}
            current_map = key
        else:
            data[key] = _unquote(value)
            current_map = None
    return data, warnings


def load_frontmatter(text):
    """Prefer PyYAML when available; fall back to the built-in subset parser."""
    try:  # pragma: no cover - optional dependency
        import yaml  # type: ignore

        fence_lines = text.splitlines()
        if fence_lines and fence_lines[0].strip() == "---":
            for index in range(1, len(fence_lines)):
                if fence_lines[index].strip() == "---":
                    try:
                        return yaml.safe_load("\n".join(fence_lines[1:index])) or {}, ["parsed with PyYAML"]
                    except Exception as exc:
                        return None, ["invalid YAML frontmatter: %s" % exc]
        return None, ["SKILL.md must begin with a '---' YAML frontmatter fence"]
    except ImportError:
        return parse_frontmatter_simple(text)


def validate_skill_frontmatter(text, skill_dir_name):
    """Validate SKILL.md content against the Agent Skills specification."""
    findings = []
    data, warnings = load_frontmatter(text)
    for warning in warnings:
        if warning != "parsed with PyYAML":
            findings.append(Finding("skill.frontmatter", warning, "error", "SKILL.md"))
    if data is None:
        return findings, {}
    if not isinstance(data, dict):
        findings.append(Finding("skill.frontmatter", "frontmatter must be a mapping", "error", "SKILL.md"))
        return findings, {}

    name = data.get("name")
    description = data.get("description")
    if not isinstance(name, str) or not name:
        findings.append(Finding("skill.name", "required frontmatter field 'name' is missing", "error", "SKILL.md"))
    else:
        if len(name) > 64:
            findings.append(Finding("skill.name", "'name' exceeds 64 characters", "error", "SKILL.md"))
        if not SKILL_NAME_RE.match(name):
            findings.append(
                Finding(
                    "skill.name",
                    "'name' must match ^[a-z0-9]+(-[a-z0-9]+)*$ (got %r)" % name,
                    "error",
                    "SKILL.md",
                )
            )
        if skill_dir_name and name != skill_dir_name:
            findings.append(
                Finding(
                    "skill.name",
                    "'name' (%r) must match the parent directory name (%r)" % (name, skill_dir_name),
                    "error",
                    "SKILL.md",
                )
            )
    if not isinstance(description, str) or not description.strip():
        findings.append(
            Finding("skill.description", "required frontmatter field 'description' is missing", "error", "SKILL.md")
        )
    elif len(description) > 1024:
        findings.append(
            Finding(
                "skill.description",
                "'description' is %d characters; the maximum is 1024" % len(description),
                "error",
                "SKILL.md",
            )
        )

    compatibility = data.get("compatibility")
    if compatibility is not None:
        if not isinstance(compatibility, str) or not compatibility.strip():
            findings.append(Finding("skill.compatibility", "'compatibility' must be a non-empty string", "error", "SKILL.md"))
        elif len(compatibility) > 500:
            findings.append(
                Finding(
                    "skill.compatibility",
                    "'compatibility' is %d characters; the maximum is 500" % len(compatibility),
                    "error",
                    "SKILL.md",
                )
            )

    license_value = data.get("license")
    if license_value is not None and not isinstance(license_value, str):
        findings.append(Finding("skill.license", "'license' must be a string", "error", "SKILL.md"))

    metadata = data.get("metadata")
    if metadata is not None:
        if not isinstance(metadata, dict):
            findings.append(Finding("skill.metadata", "'metadata' must be a mapping of string to string", "error", "SKILL.md"))
        else:
            for key, value in metadata.items():
                if not isinstance(value, str):
                    findings.append(
                        Finding(
                            "skill.metadata",
                            "metadata value for %r should be quoted so it stays a string" % key,
                            "warning",
                            "SKILL.md",
                        )
                    )

    known = {"name", "description", "license", "compatibility", "metadata", "allowed-tools"}
    for key in data:
        if key not in known:
            findings.append(
                Finding(
                    "skill.frontmatter",
                    "unknown frontmatter key %r (spec fields: %s)" % (key, ", ".join(sorted(known))),
                    "warning",
                    "SKILL.md",
                )
            )

    body_lines = text.splitlines()
    if len(body_lines) > 500:
        findings.append(
            Finding(
                "skill.body",
                "SKILL.md is %d lines; the specification recommends staying under 500" % len(body_lines),
                "warning",
                "SKILL.md",
            )
        )
    body_tokens = len(strip_comments(text).split())
    if body_tokens > 5000:
        findings.append(
            Finding(
                "skill.body",
                "SKILL.md body is roughly %d tokens; the specification recommends staying under 5000" % body_tokens,
                "warning",
                "SKILL.md",
            )
        )
    return findings, data


def referenced_bundled_files(text):
    """Find relative paths into the skill's bundled directories."""
    refs = set()
    for match in re.finditer(r"(?:scripts|references|templates|assets)/[A-Za-z0-9_./-]+", text):
        refs.add(match.group(0).rstrip(".,;:"))
    return sorted(refs)


# --------------------------------------------------------------------------
# command: init
# --------------------------------------------------------------------------


def cmd_init(args, ctx):
    findings = []
    actions = []
    templates_dir = Path(args.templates) if args.templates else default_templates_dir()
    if not templates_dir.is_dir():
        raise ProdocError(
            "templates directory not found: %s (pass --templates)" % templates_dir, exit_code=3
        )
    repo = ctx["repo"]
    for doc in CANONICAL_DOCS:
        target = repo / doc
        if target.exists() or os.path.islink(str(target)):
            if os.path.islink(str(target)):
                actions.append(
                    {"file": doc, "action": "kept", "detail": "existing symbolic link; never replaced"}
                )
            else:
                actions.append({"file": doc, "action": "kept", "detail": "already present; never overwritten"})
            continue
        source = templates_dir / doc
        if not source.is_file():
            raise ProdocError("missing bundled template: %s" % source, exit_code=3)
        text = read_text(source)
        if args.dry_run:
            actions.append({"file": doc, "action": "would-create", "detail": str(source)})
            continue
        if not os.access(str(repo), os.W_OK):
            raise ProdocError("refusing to write into read-only directory: %s" % repo, exit_code=4)
        guard_write_target(target, repo)
        write_atomic(target, text, expected_sha=None)
        actions.append({"file": doc, "action": "created", "detail": str(source)})
    created = [a["file"] for a in actions if a["action"] in ("created", "would-create")]
    if not created:
        findings.append(
            Finding(
                "init.noop",
                "all three canonical documents already exist; nothing to do",
                "info",
            )
        )
    return {
        "command": "init",
        "ok": True,
        "exit_code": 0,
        "findings": findings,
        "info": {"repo": str(repo), "templates": str(templates_dir), "actions": actions},
    }


def default_templates_dir():
    env = os.environ.get("PRODOC_TEMPLATES")
    if env:
        return Path(env)
    script = Path(__file__).resolve()
    candidate = script.parent.parent / "templates"
    return candidate


# --------------------------------------------------------------------------
# command: validate
# --------------------------------------------------------------------------


def cmd_validate(args, ctx):
    repo = ctx["repo"]
    findings = []
    info = {"repo": str(repo), "documents": {}}
    for doc in CANONICAL_DOCS:
        path = repo / doc
        if not path.is_file():
            findings.append(
                Finding("doc.missing", "%s is missing; run 'prodoc init'" % doc, "error", doc)
            )
            info["documents"][doc] = {"present": False}
            continue
        text = read_text(path)
        info["documents"][doc] = {"present": True, "bytes": len(text.encode("utf-8"))}
        findings.extend(_validate_placeholders(doc, text))
        findings.extend(_validate_sections(doc, text))
        if doc == "DECISION_LOG.md":
            findings.extend(_validate_decisions(doc, text))
        if doc == "PROJECT_STATUS.md":
            findings.extend(_validate_status(doc, text, repo))
    errors = [f for f in findings if f["severity"] == "error"]
    return {
        "command": "validate",
        "ok": not errors,
        "exit_code": 1 if errors else 0,
        "findings": findings,
        "info": info,
    }


def _validate_placeholders(doc, text):
    # TODO markers are HTML comments, so this scan deliberately looks at every
    # line: an unfilled `prodoc:todo` marker is reported wherever it appears.
    findings = []
    for offset, line in enumerate(text.splitlines(), start=1):
        for match in TODO_RE.finditer(line):
            detail = match.group(1).strip() or "template placeholder not filled in"
            findings.append(Finding("doc.placeholder", detail, "error", doc, offset))
    return findings


def _validate_sections(doc, text):
    findings = []
    sections, _ = split_sections(text)
    present = set()
    for name in sections:
        lower = name.lower()
        present.add(lower)
        if lower in SECTION_ALIASES:
            present.add(SECTION_ALIASES[lower])
            findings.append(
                Finding(
                    "doc.legacy_heading",
                    "heading '## %s' is deprecated and implies the CLI verified the "
                    "implementation; rename it to '## %s'"
                    % (name, SECTION_ALIASES[lower].title()),
                    "warning",
                    doc,
                )
            )
    for required in REQUIRED_SECTIONS[doc]:
        if required.lower() not in present:
            findings.append(
                Finding("doc.section", "missing required section '## %s'" % required, "error", doc)
            )
        elif not first_content_line("\n".join(sections[_resolve_heading(sections, required)])):
            findings.append(
                Finding("doc.section", "section '## %s' is empty" % required, "warning", doc)
            )
    return findings


def _resolve_heading(sections, required):
    """Map a required section name onto the heading actually used in the file."""
    lower = {name.lower(): name for name in sections}
    if required.lower() in lower:
        return lower[required.lower()]
    for alias, canonical in SECTION_ALIASES.items():
        if canonical == required.lower() and alias in lower:
            return lower[alias]
    return required


def _validate_decisions(doc, text):
    findings = []
    decisions = parse_decisions(text)[0]
    if not decisions:
        findings.append(
            Finding("log.empty", "no decision records found (expected '### D-0001 — Title')", "warning", doc)
        )
        return findings
    seen = set()
    previous = None
    for decision in decisions:
        did = decision["id"]
        if did in seen:
            findings.append(
                Finding("log.duplicate", "duplicate decision id %s" % did, "error", doc, decision["line"])
            )
        seen.add(did)
        if previous is not None and int(did.split("-")[1]) <= int(previous.split("-")[1]):
            findings.append(
                Finding(
                    "log.order",
                    "decision %s does not follow %s in ascending order" % (did, previous),
                    "error",
                    doc,
                    decision["line"],
                )
            )
        previous = did
        for field in DECISION_FIELDS:
            value = decision["fields"].get(field.lower(), "")
            if not value:
                findings.append(
                    Finding(
                        "log.field",
                        "decision %s is missing '%s'" % (did, field),
                        "error",
                        doc,
                        decision["line"],
                    )
                )
        status = decision["fields"].get("status", "")
        if status and status.split()[0].rstrip(":") not in DECISION_STATUSES:
            findings.append(
                Finding(
                    "log.status",
                    "decision %s has unknown status %r (allowed: %s)"
                    % (did, status, ", ".join(DECISION_STATUSES)),
                    "warning",
                    doc,
                    decision["line"],
                )
            )
    return findings


def _validate_status(doc, text, repo):
    findings = []
    phase = first_content_line(section_body(text, "Current Phase") or "")
    if phase and phase not in PHASES:
        findings.append(
            Finding(
                "status.phase",
                "phase %r is not one of: %s" % (phase, ", ".join(PHASES)),
                "warning",
                doc,
            )
        )

    observed, kind = extract_observed_block(text)
    if observed is None:
        findings.append(
            Finding(
                "status.observed_block",
                "missing managed repository-state block; run 'prodoc update'",
                "error",
                doc,
            )
        )
    else:
        if kind == "legacy":
            findings.append(
                Finding(
                    "status.legacy_block",
                    "the managed block uses the deprecated 'verified' markers, which imply that "
                    "observing Git metadata verifies the implementation; run 'prodoc update' to migrate",
                    "warning",
                    doc,
                )
            )
        for key in observed_fields_for(kind):
            if key not in observed:
                findings.append(
                    Finding(
                        "status.observed_block",
                        "repository-state block is missing '%s'" % key,
                        "error",
                        doc,
                    )
                )

    work_body = section_body(text, "Completed Work") or ""
    for offset, line, masked in masked_lines(work_body):
        if masked:
            continue
        match = WORK_ITEM_RE.match(line)
        if not match:
            continue
        state = match.group(1).strip()
        rest = match.group(2).strip()
        if state not in WORK_STATES:
            findings.append(
                Finding(
                    "status.work.state",
                    "unknown work state %r (allowed: %s)" % (state, ", ".join(WORK_STATES)),
                    "error",
                    doc,
                    offset,
                )
            )
            continue
        if state in EVIDENCE_REQUIRED_STATES and not has_evidence(rest):
            findings.append(
                Finding(
                    "status.work.evidence",
                    "work item claims '%s' without citing evidence (%s)" % (state, rest[:70]),
                    "error",
                    doc,
                    offset,
                )
            )

    findings.extend(_validate_verification(doc, text, repo, phase))
    findings.extend(_validate_tests(doc, text, repo))
    return findings


def _validate_verification(doc, text, repo, phase):
    """Check recorded verification evidence, and require it for release claims.

    This is the separation the tool is for: the observed block says what Git saw,
    and this section says what a human actually verified. A release-state claim
    needs the latter, not the former.
    """
    findings = []
    entries = parse_verification_entries(text)
    for entry in entries:
        if not entry["commit"]:
            findings.append(
                Finding(
                    "status.verification.commit",
                    "verification entry has no commit identifier: %s" % entry["text"][:70],
                    "error",
                    doc,
                    entry["line"],
                )
            )
        if not entry["evidence"]:
            findings.append(
                Finding(
                    "status.verification.evidence",
                    "verification entry cites no artefact (a path in backticks or a URL): %s"
                    % entry["text"][:70],
                    "error",
                    doc,
                    entry["line"],
                )
            )
        for token in entry["paths"]:
            if "/" not in token and not token.endswith((".md", ".json", ".txt", ".xml", ".log")):
                continue
            if not (repo / token).exists():
                findings.append(
                    Finding(
                        "status.verification.evidence_missing",
                        "verification evidence `%s` does not exist in the repository" % token,
                        "error",
                        doc,
                        entry["line"],
                    )
                )

    released_states = release_states_claimed(text)
    needs_evidence = phase in RELEASE_PHASES or bool(released_states)
    if needs_evidence and not entries:
        reason = (
            "phase is %r" % phase if phase in RELEASE_PHASES else "work is marked %s" % "/".join(released_states)
        )
        findings.append(
            Finding(
                "status.release_evidence",
                "a release-state claim requires recorded verification evidence (%s); add a "
                "'- **Verification:** commit <sha> ... evidence `<path>`' line under "
                "'## Verification Evidence'" % reason,
                "error",
                doc,
            )
        )
    return findings


def line_number_of(text, needle):
    """Best-effort 1-based line number of the first line containing needle."""
    for index, line in enumerate(text.splitlines(), start=1):
        if needle in line:
            return index
    return None


def has_evidence(text):
    if URL_RE.search(text):
        return True
    if HEX_RE.search(text):
        return True
    for token in BACKTICK_RE.findall(text):
        if token.strip():
            return True
    return False


def _validate_tests(doc, text, repo):
    findings = []
    body = section_body(text, "Tests") or ""
    rows = split_table_rows(body)
    if not rows:
        findings.append(
            Finding(
                "status.tests",
                "no test rows found; record outcomes in the Suite/Command/Result/Evidence table",
                "warning",
                doc,
            )
        )
        return findings
    for row in rows:
        if len(row) < 4:
            findings.append(
                Finding("status.tests", "test row needs 4 columns: %s" % " | ".join(row), "error", doc)
            )
            continue
        result, evidence = row[2], row[3]
        first = result.split()[0].strip("*`").lower() if result else ""
        if not first:
            findings.append(Finding("status.tests", "test row has an empty Result column", "error", doc))
            continue
        if first not in ("pass", "passing", "fail", "failing", "not", "n/a", "partial"):
            findings.append(
                Finding(
                    "status.tests",
                    "unrecognised test result %r (use Pass/Fail/Partial/Not run/N/A)" % result,
                    "error",
                    doc,
                )
            )
            continue
        if first not in ("pass", "passing", "fail", "failing", "partial"):
            continue
        if not evidence or evidence.strip("*-_ ") in ("", "n/a", "none", "tbd"):
            findings.append(
                Finding(
                    "status.tests.evidence",
                    "test result %r has no evidence reference" % result,
                    "error",
                    doc,
                )
            )
            continue
        # A cited report that does not exist is a fabricated result, not a typo.
        for token in BACKTICK_RE.findall(evidence):
            token = token.strip()
            if not token or "*" in token or " " in token:
                continue
            if not re.match(r"^[A-Za-z0-9_.][A-Za-z0-9_./-]*$", token):
                continue
            if "/" not in token and not token.endswith((".md", ".json", ".txt", ".xml", ".log")):
                continue
            if not (repo / token).exists():
                findings.append(
                    Finding(
                        "status.tests.evidence_missing",
                        "test evidence `%s` does not exist in the repository" % token,
                        "error",
                        doc,
                    )
                )
    return findings


def extract_observed_block(text):
    """Return (values, kind) for the managed Git-metadata block.

    kind is "observed" for the current markers, "legacy" for the older
    `prodoc:verified` markers still found in existing projects, or None when no
    block is present at all.
    """
    for start_marker, end_marker, kind in (
        (OBSERVED_START, OBSERVED_END, "observed"),
        (LEGACY_OBSERVED_START, LEGACY_OBSERVED_END, "legacy"),
    ):
        start = text.find(start_marker)
        end = text.find(end_marker)
        if start == -1 or end == -1 or end < start:
            continue
        block = text[start + len(start_marker) : end]
        values = {}
        for line in block.splitlines():
            match = FIELD_RE.match(line)
            if match:
                values[match.group(1).strip().lower()] = match.group(2).strip().strip("*`")
        return values, kind
    return None, None


def observed_fields_for(kind):
    return LEGACY_OBSERVED_FIELDS if kind == "legacy" else OBSERVED_FIELDS


# --------------------------------------------------------------------------
# command: status
# --------------------------------------------------------------------------


def cmd_status(args, ctx):
    repo = ctx["repo"]
    findings = []
    root = git_root(repo)
    info = {
        "repo": str(repo),
        "git": {},
        "documents": {},
    }
    if not have_git():
        findings.append(Finding("git.missing", "git executable not found on PATH", "warning"))
    elif root is None:
        findings.append(
            Finding("git.none", "%s is not inside a Git working tree" % repo, "warning")
        )
    else:
        info["git"]["root"] = str(root)
        rc, head, _ = git(["rev-parse", "HEAD"], cwd=root)
        if rc == 0:
            info["git"]["commit"] = head
            info["git"]["commit_short"] = head[:7]
        branch, detached = git_branch(root)
        info["git"]["detached"] = detached
        info["git"]["branch"] = branch
        if detached:
            findings.append(
                Finding("git.detached", "HEAD is detached; no branch to record", "warning")
            )
        rc, porcelain, _ = git(["status", "--porcelain"], cwd=root)
        if rc == 0:
            changed = [line for line in porcelain.splitlines() if line.strip()]
            info["git"]["working_tree"] = "dirty" if changed else "clean"
            info["git"]["changed_count"] = len(changed)
            info["git"]["changed"] = changed[:20]
            if changed:
                findings.append(
                    Finding(
                        "git.dirty",
                        "%d file(s) with uncommitted changes" % len(changed),
                        "warning",
                    )
                )
        rc, remotes, _ = git(["remote", "-v"], cwd=root)
        parsed = {}
        if rc == 0:
            for line in remotes.splitlines():
                parts = line.split()
                if len(parts) >= 2:
                    parsed.setdefault(parts[0], redact_url(parts[1]))
        info["git"]["remotes"] = parsed
        if not parsed:
            findings.append(
                Finding("git.no_remote", "no Git remotes configured; remote writes are impossible", "warning")
            )

    for doc in CANONICAL_DOCS:
        path = repo / doc
        entry = {"present": path.is_file()}
        if entry["present"]:
            text = read_text(path)
            entry["bytes"] = len(text.encode("utf-8"))
            if doc == "PROJECT_STATUS.md":
                entry["phase"] = first_content_line(section_body(text, "Current Phase") or "")
                values, kind = extract_observed_block(text)
                entry["observed"] = values
                entry["observed_block_kind"] = kind
                entry["verification_entries"] = len(parse_verification_entries(text))
                entry["tests"] = split_table_rows(section_body(text, "Tests") or "")
        info["documents"][doc] = entry
    return {
        "command": "status",
        "ok": True,
        "exit_code": 0,
        "findings": findings,
        "info": info,
    }


# --------------------------------------------------------------------------
# command: check
# --------------------------------------------------------------------------


def cmd_check(args, ctx):
    repo = ctx["repo"]
    findings = []
    info = {"repo": str(repo), "checks": []}

    for doc in CANONICAL_DOCS:
        if not (repo / doc).is_file():
            findings.append(Finding("doc.missing", "%s is missing; run 'prodoc init'" % doc, "error", doc))

    # 1. secret scan
    for doc in CANONICAL_DOCS:
        path = repo / doc
        if not path.is_file():
            continue
        for offset, line in enumerate(read_text(path).splitlines(), start=1):
            for label, pattern in SECRET_PATTERNS:
                match = pattern.search(line)
                if match:
                    candidate = match.group(1) if match.groups() else match.group(0)
                    findings.append(
                        Finding(
                            "security.secret",
                            "possible %s detected (redacted: %s); remove before committing"
                            % (label, redact(candidate)),
                            "error",
                            doc,
                            offset,
                        )
                    )
    info["checks"].append("secret-scan")

    # 2. decision history integrity vs HEAD
    #
    #    This is an integrity check, not tamper-proof protection. It compares the
    #    working tree against the current HEAD, so it catches an edited, deleted,
    #    or reordered record before it is committed. Anyone able to rewrite Git
    #    history (amend, rebase, filter-branch) can also rewrite this comparison's
    #    baseline, and the CLI cannot detect that.
    root = git_root(repo)
    shallow = is_shallow(root)
    if shallow:
        findings.append(
            Finding(
                "git.shallow",
                "shallow clone: history is truncated, so recorded commits cannot be confirmed to exist "
                "or not. Fetch full history (git fetch --unshallow) to check them; this is reported "
                "rather than treated as failure",
                "info",
            )
        )
        info["checks"].append("shallow-history-notice")
    if root is not None and (root / "DECISION_LOG.md").is_file():
        rc, committed, _ = git(["show", "HEAD:DECISION_LOG.md"], cwd=root)
        if rc == 0:
            committed_records = parse_decisions(committed)[0]
            current_records = parse_decisions(read_text(root / "DECISION_LOG.md"))[0]
            committed_by_id = {d["id"]: d for d in committed_records}
            current_by_id = {d["id"]: d for d in current_records}

            removed = sorted(set(committed_by_id) - set(current_by_id))
            if removed:
                findings.append(
                    Finding(
                        "log.append_only",
                        "decision records present at HEAD are missing from the working tree: %s"
                        % ", ".join(removed),
                        "error",
                        "DECISION_LOG.md",
                    )
                )

            committed_order = [d["id"] for d in committed_records]
            current_order = [d["id"] for d in current_records]
            if current_order[: len(committed_order)] != committed_order:
                findings.append(
                    Finding(
                        "log.reordered",
                        "decision records have been reordered; history at HEAD is %s but the "
                        "working tree starts %s"
                        % (", ".join(committed_order) or "(none)", ", ".join(current_order[: len(committed_order)]) or "(none)"),
                        "error",
                        "DECISION_LOG.md",
                    )
                )

            for decision_id, before in committed_by_id.items():
                after = current_by_id.get(decision_id)
                if after is None:
                    continue  # reported as removed above
                changed = altered_decision_fields(before, after)
                if changed:
                    findings.append(
                        Finding(
                            "log.modified",
                            "decision %s has been altered (%s); history is append-only — revert the "
                            "change or supersede the record with a new one"
                            % (decision_id, ", ".join(changed)),
                            "error",
                            "DECISION_LOG.md",
                            after["line"],
                        )
                    )
                    continue
                before_status = normalized(before["fields"].get("status", ""))
                after_status = normalized(after["fields"].get("status", ""))
                if before_status != after_status:
                    findings.append(
                        Finding(
                            "log.status_changed",
                            "decision %s status changed from %r to %r; allowed, and reported so it "
                            "is visible in review" % (decision_id, before_status, after_status),
                            "warning",
                            "DECISION_LOG.md",
                            after["line"],
                        )
                    )
            info["checks"].append("decision-history")
        else:
            findings.append(
                Finding("log.no_history", "DECISION_LOG.md is not committed yet; history check skipped", "info")
            )
    else:
        findings.append(
            Finding(
                "log.no_git",
                "no Git history available; append-only and history checks skipped",
                "info",
            )
        )

    # 3. observed block against the real repository
    status_path = repo / "PROJECT_STATUS.md"
    head_info = {}
    if root is not None:
        rc, head, _ = git(["rev-parse", "HEAD"], cwd=root)
        if rc == 0:
            head_info["commit"] = head
        branch_name, detached = git_branch(root)
        if branch_name and not detached:
            head_info["branch"] = branch_name
    if status_path.is_file():
        text = read_text(status_path)
        observed, kind = extract_observed_block(text)
        if observed:
            if kind == "legacy":
                findings.append(
                    Finding(
                        "status.legacy_block",
                        "the managed block uses the deprecated 'verified' markers; run 'prodoc update'",
                        "warning",
                        "PROJECT_STATUS.md",
                    )
                )
            commit = observed.get("observed commit") or observed.get("commit") or ""
            if commit and commit != "-" and root is not None:
                rc, _, _ = git(["rev-parse", "--verify", "%s^{commit}" % commit], cwd=root)
                if rc != 0 and shallow:
                    findings.append(
                        Finding(
                            "status.commit_unavailable",
                            "recorded commit %s is not present in this shallow clone; it is not shown to be "
                            "unknown, the local history is truncated" % commit[:7],
                            "warning",
                            "PROJECT_STATUS.md",
                        )
                    )
                elif rc != 0:
                    findings.append(
                        Finding(
                            "status.commit_unknown",
                            "recorded commit %s does not exist in this repository" % redact(commit, 7),
                            "error",
                            "PROJECT_STATUS.md",
                        )
                    )
                elif head_info.get("commit") and not head_info["commit"].startswith(commit):
                    findings.append(
                        Finding(
                            "status.stale",
                            "recorded commit %s is not HEAD (%s); run 'prodoc update'"
                            % (commit[:7], head_info["commit"][:7]),
                            "warning",
                            "PROJECT_STATUS.md",
                        )
                    )
            branch = observed.get("observed branch") or observed.get("branch") or ""
            if branch and branch != "-" and head_info.get("branch") and branch != head_info["branch"]:
                findings.append(
                    Finding(
                        "status.branch_mismatch",
                        "recorded branch %r does not match current branch %r"
                        % (branch, head_info["branch"]),
                        "warning",
                        "PROJECT_STATUS.md",
                    )
                )
        info["checks"].append("observed-state")

        # 3b. recorded verification evidence must point at a real commit
        for entry in parse_verification_entries(text):
            if not entry["commit"] or root is None:
                continue
            rc, _, _ = git(["rev-parse", "--verify", "%s^{commit}" % entry["commit"]], cwd=root)
            if rc != 0 and shallow:
                findings.append(
                    Finding(
                        "status.verification_commit_unavailable",
                        "verification evidence cites commit %s, which is not present in this shallow clone; "
                        "the local history is truncated, so this is unconfirmed rather than wrong"
                        % redact(entry["commit"], 7),
                        "warning",
                        "PROJECT_STATUS.md",
                        entry["line"],
                    )
                )
            elif rc != 0:
                findings.append(
                    Finding(
                        "status.verification_commit_unknown",
                        "verification evidence cites commit %s, which does not exist in this repository"
                        % redact(entry["commit"], 7),
                        "error",
                        "PROJECT_STATUS.md",
                        entry["line"],
                    )
                )
        info["checks"].append("verification-evidence")

    # 4. paths cited as evidence must exist
    #    Only claim sites are scanned: work items, and the Evidence column of the
    #    tests table. Prose elsewhere in the document is not treated as evidence.
    if status_path.is_file():
        text = read_text(status_path)
        cited = (section_body(text, "Completed Work") or "").splitlines()
        cited += [
            row[3]
            for row in split_table_rows(section_body(text, "Tests") or "")
            if len(row) >= 4
        ]
        for line in cited:
            for token in BACKTICK_RE.findall(line):
                token = token.strip()
                if not token or "*" in token or " " in token:
                    continue
                if not re.match(r"^[A-Za-z0-9_.][A-Za-z0-9_./-]*$", token):
                    continue
                if "/" not in token and not token.endswith((".md", ".py", ".yml", ".yaml", ".json")):
                    continue
                if not (repo / token).exists():
                    findings.append(
                        Finding(
                            "status.path_missing",
                            "cited path `%s` does not exist" % token,
                            "warning",
                            "PROJECT_STATUS.md",
                            line_number_of(text, token),
                        )
                    )
        info["checks"].append("cited-paths")

    errors = [f for f in findings if f["severity"] == "error"]
    return {
        "command": "check",
        "ok": not errors,
        "exit_code": 1 if errors else 0,
        "findings": findings,
        "info": info,
    }


# --------------------------------------------------------------------------
# command: update
# --------------------------------------------------------------------------


def cmd_update(args, ctx):
    """Refresh the managed block that records Git metadata.

    This observes a branch, a commit, tree state and a timestamp. It does not run
    or verify tests and says nothing about whether the implementation is correct;
    that belongs in `## Verification Evidence`, which this command never writes.
    """
    repo = ctx["repo"]
    status_path = repo / "PROJECT_STATUS.md"
    if not status_path.is_file():
        raise ProdocError("PROJECT_STATUS.md not found in %s; run 'prodoc init'" % repo, exit_code=3)
    findings = []
    original = read_text(status_path)
    if OBSERVED_START not in original and LEGACY_OBSERVED_START not in original:
        raise ProdocError(
            "PROJECT_STATUS.md has no managed repository-state block; expected %s or the "
            "legacy %s" % (OBSERVED_START, LEGACY_OBSERVED_START),
            exit_code=1,
        )
    legacy = OBSERVED_START not in original

    if args.phase:
        if args.phase not in PHASES:
            raise ProdocError("--phase must be one of: %s" % ", ".join(PHASES), exit_code=2)
        if args.phase in RELEASE_PHASES:
            entries = parse_verification_entries(original)
            if not entries:
                raise ProdocError(
                    "refusing to mark the project %r: a release-state transition requires recorded "
                    "verification evidence under '## Verification Evidence' (a commit identifier and "
                    "an artefact). `prodoc update` observes Git metadata and cannot supply it."
                    % args.phase,
                    exit_code=1,
                )

    root = git_root(repo)
    observed = {"observed branch": "-", "observed commit": "-", "observed working tree": "unknown"}
    if root is None:
        findings.append(
            Finding(
                "git.none",
                "no Git working tree; the observed block records '-' placeholders",
                "warning",
            )
        )
    else:
        rc, commit, _ = git(["rev-parse", "HEAD"], cwd=root)
        if rc == 0:
            observed["observed commit"] = commit
        else:
            findings.append(Finding("update.no_commits", "repository has no commits yet", "warning"))
        branch, detached = git_branch(root)
        if detached:
            observed["observed branch"] = "detached-head"
            findings.append(
                Finding(
                    "git.detached",
                    "HEAD is detached; recording 'detached-head' instead of a branch name",
                    "warning",
                )
            )
        elif branch:
            observed["observed branch"] = branch
        rc, porcelain, _ = git(["status", "--porcelain"], cwd=root)
        if rc == 0:
            observed["observed working tree"] = "dirty" if porcelain.strip() else "clean"
    observed["observed at"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    block = "\n".join(
        [
            OBSERVED_START,
            "<!-- %s -->" % OBSERVED_CAVEAT,
            "- **Observed branch:** %s" % observed["observed branch"],
            "- **Observed commit:** %s" % observed["observed commit"],
            "- **Observed working tree:** %s" % observed["observed working tree"],
            "- **Observed at:** %s" % observed["observed at"],
            OBSERVED_END,
        ]
    )
    pattern = re.compile(
        "(?:%s|%s).*?(?:%s|%s)"
        % (
            re.escape(OBSERVED_START),
            re.escape(LEGACY_OBSERVED_START),
            re.escape(OBSERVED_END),
            re.escape(LEGACY_OBSERVED_END),
        ),
        re.DOTALL,
    )
    if not pattern.search(original):
        raise ProdocError(
            "PROJECT_STATUS.md has an unterminated managed block; both markers of one kind are required",
            exit_code=1,
        )
    updated = pattern.sub(lambda _match: block, original, count=1)

    if legacy:
        findings.append(
            Finding(
                "update.migrated",
                "replaced the deprecated 'verified' markers and field names with observed-state ones",
                "info",
            )
        )

    if args.phase:
        updated = _set_phase(updated, args.phase)

    if updated == original:
        findings.append(
            Finding("update.noop", "observed state already current; no change written", "info")
        )

    result_info = {
        "repo": str(repo),
        "dry_run": bool(args.dry_run),
        "observed": observed,
        "changed": updated != original,
        "caveat": OBSERVED_CAVEAT,
    }
    if args.dry_run:
        return {
            "command": "update",
            "ok": True,
            "exit_code": 0,
            "findings": findings,
            "info": result_info,
        }

    if updated != original:
        guard_write_target(status_path, repo)
        write_atomic(status_path, updated, expected_sha=sha256_text(original))
    return {
        "command": "update",
        "ok": True,
        "exit_code": 0,
        "findings": findings,
        "info": result_info,
    }


def _set_phase(text, phase):
    lines = text.splitlines()
    out = []
    in_phase = False
    written = False
    for line in lines:
        match = H2_RE.match(line)
        if match:
            in_phase = match.group(1).strip().lower() == "current phase"
            out.append(line)
            continue
        if in_phase and not written and line.strip() and not line.strip().startswith("<!--"):
            indent = line[: len(line) - len(line.lstrip())]
            out.append("%s%s" % (indent, phase))
            written = True
            continue
        out.append(line)
    if not written:
        raise ProdocError("could not locate a value under '## Current Phase'", exit_code=1)
    return "\n".join(out) + ("\n" if text.endswith("\n") else "")


# --------------------------------------------------------------------------
# output
# --------------------------------------------------------------------------


ICON = {"error": "ERROR", "warning": "WARN", "info": "INFO"}


def emit(result, args):
    if args.json:
        payload = dict(result)
        payload["version"] = VERSION
        # de-duplicate findings for stable machine consumption
        sys.stdout.write(json.dumps(payload, indent=2, sort_keys=False) + "\n")
        return
    if args.quiet and result["ok"]:
        return
    lines = []
    status = "OK" if result["ok"] else "FAILED"
    lines.append("prodoc %s: %s" % (result["command"], status))
    for finding in result["findings"]:
        location = finding.get("file") or ""
        if finding.get("line"):
            location += ":%d" % finding["line"]
        prefix = "%s:" % ICON.get(finding["severity"], finding["severity"])
        lines.append(
            "  %-6s %s %s" % (prefix, ("%s " % location) if location else "", finding["message"])
        )
    info = result.get("info", {})
    if result["command"] == "init":
        for action in info.get("actions", []):
            lines.append("  %-9s %s" % (action["action"], action["file"]))
        if any(a["action"] in ("created", "would-create") for a in info.get("actions", [])):
            lines.append("")
            lines.append("Next: fill in the documents, then run 'prodoc validate'.")
    if result["command"] == "status":
        ginfo = info.get("git", {})
        lines.append("  repo:    %s" % info.get("repo"))
        if ginfo.get("root"):
            lines.append(
                "  git:     branch=%s commit=%s tree=%s"
                % (
                    ginfo.get("branch") or ("(detached)" if ginfo.get("detached") else "-"),
                    ginfo.get("commit_short", "-"),
                    ginfo.get("working_tree", "-"),
                )
            )
            remotes = ginfo.get("remotes", {})
            lines.append(
                "  remotes: %s" % (", ".join("%s=%s" % kv for kv in remotes.items()) or "none")
            )
            if ginfo.get("changed"):
                for entry in ginfo["changed"]:
                    lines.append("    %s" % entry)
        else:
            lines.append("  git:     unavailable")
        for doc, entry in info.get("documents", {}).items():
            marker = "present" if entry.get("present") else "MISSING"
            extra = ""
            if entry.get("phase"):
                extra = "  phase=%s" % entry["phase"]
            lines.append("  %-24s %s%s" % (doc, marker, extra))
    if result["command"] == "update":
        observed = info.get("observed", {})
        lines.append(
            "  observed branch=%s commit=%s tree=%s at=%s"
            % (
                observed.get("observed branch"),
                (observed.get("observed commit") or "")[:12],
                observed.get("observed working tree"),
                observed.get("observed at"),
            )
        )
        lines.append(
            "  note: Git metadata only. This is not verification of the implementation or its "
            "tests; that lives under '## Verification Evidence'."
        )
        if info.get("dry_run"):
            lines.append("  dry run: no files written")
    sys.stdout.write("\n".join(lines) + "\n")


# --------------------------------------------------------------------------
# entry point
# --------------------------------------------------------------------------


def build_parser():
    parser = argparse.ArgumentParser(
        prog="prodoc",
        description=(
            "ProDoc Guard: keep PRODUCT_REQUIREMENTS.md, DECISION_LOG.md and "
            "PROJECT_STATUS.md present, valid and consistent with Git. "
            "Offline, read-only unless a write is explicitly requested, and never "
            "commits or pushes."
        ),
        epilog=(
            "exit codes: 0 ok, 1 validation/consistency errors, 2 usage error, "
            "3 environment error, 4 unsafe state (read-only or concurrent modification)"
        ),
    )
    parser.add_argument("--version", action="version", version="prodoc %s" % VERSION)
    subparsers = parser.add_subparsers(dest="command")

    def add_common(sub, needs_templates=False):
        sub.add_argument(
            "--repo",
            default=None,
            help="project directory containing the canonical documents (default: cwd)",
        )
        sub.add_argument("--json", action="store_true", help="emit machine-readable JSON on stdout")
        sub.add_argument("--quiet", action="store_true", help="suppress output when successful")
        if needs_templates:
            sub.add_argument(
                "--templates",
                default=None,
                help="directory holding the bundled document templates (default: ../templates)",
            )

    init = subparsers.add_parser("init", help="create missing canonical documents from templates")
    add_common(init, needs_templates=True)
    init.add_argument("--dry-run", action="store_true", help="report actions without writing")

    validate = subparsers.add_parser("validate", help="validate document structure and required sections")
    add_common(validate)

    status = subparsers.add_parser("status", help="report repository and document state")
    add_common(status)

    check = subparsers.add_parser("check", help="check consistency, evidence and secrets")
    add_common(check)

    update = subparsers.add_parser(
        "update", help="refresh the observed repository-state block (Git metadata only)"
    )
    add_common(update)
    update.add_argument("--dry-run", action="store_true", help="preview without writing")
    update.add_argument("--phase", default=None, help="explicitly set the project phase")

    return parser


def resolve_project_dir(repo):
    """Prefer the directory that actually holds the canonical documents.

    Running a command from a subdirectory should still find the project's
    documents. The redirect only happens when documents exist elsewhere *and* the
    selected directory is inside that same Git worktree, so a nested repository or
    an unrelated tree is never reached into: if `repo` belongs to an inner
    repository, `git_root` returns the inner root and the outer project is not a
    candidate. `init` never redirects, so it writes where the user asked.
    """
    if any((repo / doc).is_file() or os.path.islink(str(repo / doc)) for doc in CANONICAL_DOCS):
        return repo, False
    root = git_root(repo)
    if root is None or root == repo or not is_within(repo, root):
        return repo, False
    if any((root / doc).is_file() for doc in CANONICAL_DOCS):
        return root, True
    return repo, False


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 2

    requested = Path(args.repo).expanduser().resolve() if args.repo else Path.cwd()
    if not requested.is_dir():
        sys.stderr.write("prodoc: repo path does not exist: %s\n" % requested)
        return 3
    repo, redirected = resolve_project_dir(requested)
    ctx = {"repo": repo}

    handlers = {
        "init": cmd_init,
        "validate": cmd_validate,
        "status": cmd_status,
        "check": cmd_check,
        "update": cmd_update,
    }
    try:
        result = handlers[args.command](args, ctx)
    except ProdocError as exc:
        sys.stderr.write("prodoc: %s\n" % exc)
        return exc.exit_code
    except KeyboardInterrupt:  # pragma: no cover
        sys.stderr.write("prodoc: interrupted\n")
        return 4
    if redirected:
        result["findings"].insert(
            0,
            Finding(
                "repo.worktree_root",
                "canonical documents are at the Git worktree root; using %s" % repo,
                "info",
            ),
        )
    emit(result, args)
    return result["exit_code"]


if __name__ == "__main__":
    sys.exit(main())
